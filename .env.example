# Supabase Configuration (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key...

# Flutterwave Configuration (from Flutterwave Dashboard -> Settings -> API Keys & Webhooks)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
# Secret Hash for Webhook signature verification (set in Flutterwave Dashboard -> Webhooks -> Secret hash)
FLW_SECRET_HASH=kts_secure_webhook_hash_2026
